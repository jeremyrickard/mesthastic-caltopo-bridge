# Use /dev/cu.usbmodem* on macOS. On Linux prefer the stable by-id symlink.
MESHTASTIC_SERIAL_DEVICE=/dev/serial/by-id/usb-Meshtastic_Example-if00
MESHTASTIC_SERIAL_BAUD=115200
BRIDGE_DATABASE_PATH=/var/lib/meshtastic-caltopo-bridge/bridge.db
HTTP_LISTEN_ADDRESS=127.0.0.1:8080
# Logs raw serial bytes and decoded radio messages. This may expose sensitive data.
BRIDGE_DEBUG=false
# Decode standard Meshtastic POSITION_APP packets on port 3.
DECODE_POSITION_APP=true

# The radio must already have the private Meshtastic channel key.
# Channel keys do not belong in this file.

CALTOPO_ENABLED=false
CALTOPO_ENDPOINT=caltopo.com
CALTOPO_MAP_ID=
CALTOPO_CREDENTIAL_ID=
CALTOPO_KEY=
CALTOPO_ACCOUNT_ID=
CALTOPO_GROUP=mesh
CALTOPO_TIMEOUT=10s
